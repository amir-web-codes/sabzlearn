# Environment
NODE_ENV=development

# Server
PORT=7000

# Database
DATABASE_URL=mongodb://localhost:27017/sabzlearn

# JWT
ACCESS_TOKEN_KEY=your_access_token_key_here_min_32_chars_long
REFRESH_TOKEN_KEY=your_refresh_token_key_here_min_32_chars_long

# CORS Configuration
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Logging
LOG_LEVEL=debug

# redis
redis_URL=REDIS_URL=redis://default:PASSWORD@HOST:PORT